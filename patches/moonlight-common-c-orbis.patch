diff --git a/src/PlatformSockets.h b/src/PlatformSockets.h
index 4bac8bd..1e95744 100644
--- a/src/PlatformSockets.h
+++ b/src/PlatformSockets.h
@@ -18,6 +18,12 @@ extern in_port_t n3ds_udp_port;
 #endif
 #endif
 
+#if defined(__ORBIS__) || defined(__PS4__) || defined(__OPENORBIS__)
+#ifdef AF_INET6
+#undef AF_INET6
+#endif
+#endif
+
 #if defined(_WIN32) && !defined(NXDK)
 #define WIN32_LEAN_AND_MEAN
 #include <windows.h>
@@ -96,6 +102,29 @@ typedef ssize_t SOCK_RET;
 typedef socklen_t SOCKADDR_LEN;
 #endif
 
+#if defined(__ORBIS__) || defined(__PS4__) || defined(__OPENORBIS__)
+// OpenOrbis musl: sockaddr_in is BSD layout (sin_len@0, sin_family@1) but
+// sockaddr_storage.ss_family is at offset 0 (Linux-style). After getaddrinfo/
+// getsockname, reading ss_family returns the length (16) and socket(16,...) fails
+// with EPROTONOSUPPORT (43). Always use LC_ADDR_FAMILY.
+#include <stdint.h>
+static inline int lcAddrFamily(const struct sockaddr_storage* addr) {
+    const uint8_t* b = (const uint8_t*)addr;
+    if (b[1] == AF_INET)
+        return AF_INET;
+#ifdef AF_INET6
+    if (b[1] == AF_INET6)
+        return AF_INET6;
+#endif
+    if (addr->ss_family == AF_INET)
+        return AF_INET;
+    return b[1] ? (int)b[1] : (int)addr->ss_family;
+}
+#define LC_ADDR_FAMILY(addr) lcAddrFamily((const struct sockaddr_storage*)(addr))
+#else
+#define LC_ADDR_FAMILY(addr) ((addr)->ss_family)
+#endif
+
 #ifdef AF_INET6
 typedef struct sockaddr_in6 LC_SOCKADDR;
 #define SET_FAMILY(addr, family) ((addr)->sin6_family = (family))
